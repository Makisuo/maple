{
	"include": ["alchemy.run.ts", "src/**/*.ts"],
	"compilerOptions": {
		"lib": ["esnext"],
		"target": "esnext",
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node", "@cloudflare/workers-types"]
	}
}
