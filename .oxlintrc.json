{
	"jsPlugins": ["./scripts/oxlint-plugins/maple.mjs", "./scripts/oxlint-plugins/anti-slop/index.ts"],
	"rules": {
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": ["error", { "allowWithTestSeamComment": true }],
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": [
			"error",
			{
				"allowInTypeGuards": true,
				"allowInBoundaryFunctions": true,
				"checkUnknownOnly": true
			}
		],
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": [
			"error",
			{ "allowInBoundaryFunctions": true, "allowWithBoundaryComment": true }
		],
		"anti-slop/no-unknown-returns": ["error", { "allowWithBoundaryComment": true }],
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": [
			"error",
			{ "check": "unsafe", "allowFileSafetyComment": true }
		],
		"maple/no-record-string-any": "error",
		"typescript/no-explicit-any": "warn",
		"no-alert": "error",
		"oxc/approx-constant": "warn",
		"no-plusplus": "off",
		"require-yield": "off",
		"no-restricted-imports": [
			"warn",
			{
				"paths": [
					{
						"name": "react",
						"importNames": ["useEffect"],
						"message": "Do not use useEffect. Use useMountEffect for mount-only external sync, derive state inline, use event handlers, or use TanStack Query. See /no-use-effect. Bump to 'error' once all existing call sites are refactored."
					}
				]
			}
		]
	},
	"overrides": [
		{
			"files": ["lib/**"],
			"rules": {
				"anti-slop/no-unsafe-dictionary-type": "off",
				"maple/no-record-string-any": "off",
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": [
				"packages/domain/src/http/v2/openapi.test.ts",
				"packages/domain/src/http/planetscale-v1-compat.test.ts"
			],
			"rules": {
				"anti-slop/no-unsafe-dictionary-type": "off",
				"maple/no-record-string-any": "off"
			}
		},
		{
			"files": ["apps/api/src/**/*.ts", "apps/api/src/**/*.tsx"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["**/vendor/*", "**/vendor/*/**"],
								"message": "VCS provider implementations under services/vcs/vendor/** are vendor-specific. Do NOT import them directly — go through the provider-agnostic VCS layer (VcsProviderRegistry, VcsSyncService, VcsCommitService, VcsProviderClient, …) so VCS features stay provider-agnostic. The only files allowed to reference vendor code are the composition roots (app.ts, vcs-sync-runtime.ts), the VcsProviderRegistry that wires providers, the GitHub OAuth/connect HTTP route, and tests — see the allowlist in .oxlintrc.json."
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"apps/api/src/app.ts",
				"apps/api/src/vcs-sync-runtime.ts",
				"apps/api/src/runtime/mcp-service-graph.ts",
				"apps/api/src/runtime/service-graph.ts",
				"apps/api/src/services/integrations/vcs/VcsProviderRegistry.ts",
				"apps/api/src/routes/v1/integrations.http.ts",
				"apps/api/src/services/integrations/vcs/vendor/**",
				"apps/api/src/**/__tests__/**"
			],
			"rules": {
				"no-restricted-imports": "off"
			}
		}
	],
	"ignorePatterns": [
		".agents/**",
		".codex/**",
		".context/**",
		".deepsec/**",
		".factory/**",
		".impeccable/**",
		".superset/**",
		"lib/llm/**",
		"lib/thinking-orbs/**",
		"scripts/oxlint-plugins/anti-slop/**"
	]
}
