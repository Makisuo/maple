{
	"include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		// ES2023 (not query-engine's ES2022): vendored upstream uses `findLast`/`findLastIndex`/`toSorted`.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		// `vite/client` types `import.meta.glob`, which the cassette replay layer and the image
		// fixture in `test/` use in place of upstream's Bun/Node filesystem reads.
		"types": ["node", "vite/client"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"plugins": [
			{
				"name": "@effect/language-service",
				"reportSuggestionsAsWarningsInTsc": true
			}
		]
	}
}
