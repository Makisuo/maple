{
	"name": "@maple-dev/clickhouse-builder",
	"version": "0.1.0",
	"description": "A type-safe, immutable ClickHouse SQL query builder for TypeScript",
	"keywords": [
		"clickhouse",
		"effect",
		"query-builder",
		"sql",
		"typescript"
	],
	"homepage": "https://github.com/MapleTechLabs/maple/tree/main/lib/clickhouse-builder#readme",
	"bugs": {
		"url": "https://github.com/MapleTechLabs/maple/issues"
	},
	"license": "MIT",
	"author": "Makisuo, Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MapleTechLabs/maple.git",
		"directory": "lib/clickhouse-builder"
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./expr": {
			"types": "./dist/expr.d.mts",
			"import": "./dist/expr.mjs"
		},
		"./types": {
			"types": "./dist/types.d.mts",
			"import": "./dist/types.mjs"
		},
		"./sql": {
			"types": "./dist/sql.d.mts",
			"import": "./dist/sql.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"@effect/language-service": "catalog:effect",
		"@types/node": "catalog:tooling",
		"effect": "catalog:effect",
		"expect-type": "^1.3.0",
		"tsdown": "^0.22.14",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": ">=4.0.0-beta.33"
	}
}
