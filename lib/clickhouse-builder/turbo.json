{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		// This package's test script reads its own dist/ (check-exports-documented.mjs
		// verifies dist/index.d.mts), so it needs "build", not just the root's "^build".
		"test": {
			"dependsOn": ["build", "^build"],
			"outputs": []
		}
	}
}
