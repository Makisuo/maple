// Copy to Secrets.xcconfig (gitignored) and fill in.
//
// This is a *publishable* key — the web app ships the same class of value in
// its JS bundle as VITE_CLERK_PUBLISHABLE_KEY — so keeping it out of git is
// about not baking a prod-vs-test choice into source, not confidentiality.
//
// Take the value from the Clerk dashboard, or from .env.local's
// VITE_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY = pk_test_your_key_here

// Uncomment to point the simulator at a locally-run API instead of production.
// Note xcconfig treats `//` as a comment, so the scheme separator needs the
// $() escape hatch.
// MAPLE_API_BASE_URL = http:/$()/localhost:3472
