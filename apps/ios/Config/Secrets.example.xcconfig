// Copy to Secrets.xcconfig (gitignored) and fill in.
//
// This is a *publishable* key — the web app ships the same class of value in
// its JS bundle as VITE_CLERK_PUBLISHABLE_KEY — so keeping it out of git is
// about not baking a prod-vs-test choice into source, not confidentiality.
//
// Take the value from the Clerk dashboard, or from .env.local's
// VITE_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY = pk_test_your_key_here

// Uncomment to point the simulator at a locally-run API instead of production.
// Note xcconfig treats `//` as a comment, so the scheme separator needs the
// $() escape hatch.
// MAPLE_API_BASE_URL = http:/$()/localhost:3472

// Maple's own telemetry — the PUBLIC ingest key, `maple_pk_…`. Leave it unset
// and the SDK stays quiet: no spans, no recordings, one log line at launch.
// Take the value from https:/$()/app.maple.dev/developer?tab=ingestion.
// MAPLE_INGEST_KEY = maple_pk_your_key_here

// Point telemetry at a local gateway or staging instead of production. Same
// $() escape as MAPLE_API_BASE_URL, for the same reason.
// MAPLE_INGEST_ENDPOINT = http:/$()/localhost:3475

// Required only to run on a physical device or archive for TestFlight; the
// simulator needs no signing. 10 characters, from developer.apple.com →
// Account → Membership details.
// DEVELOPMENT_TEAM = XXXXXXXXXX
