---
import { getGitHubStars, formatStars } from "../lib/github-stars";

const stars = await getGitHubStars();
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg transition-colors duration-200">
    <div class="mx-auto max-w-6xl px-6 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
            <div class="w-7 h-7 bg-primary flex items-center justify-center">
                <span class="text-primary-foreground text-xs font-bold">M</span>
            </div>
            <span class="text-foreground text-sm font-medium">Maple <span class="text-primary">Local</span></span>
        </a>

        <div class="flex items-center gap-1 sm:gap-2">
            <a href="/docs" class="px-3 py-1.5 text-xs text-fg-muted hover:text-foreground transition-colors">Docs</a>
            <a
                href="https://github.com/Makisuo/maple/releases"
                target="_blank"
                rel="noopener noreferrer"
                class="hidden sm:inline-flex px-3 py-1.5 text-xs text-fg-muted hover:text-foreground transition-colors"
            >
                Releases
            </a>
            <a
                href="https://github.com/Makisuo/maple"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs text-fg-muted hover:text-foreground transition-colors"
            >
                <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 fill-current" aria-hidden="true">
                    <path
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                    ></path>
                </svg>
                <span class="hidden sm:inline">GitHub</span>
                {stars !== null && <span class="font-mono text-[10px] text-fg-muted">{formatStars(stars)}</span>}
            </a>
            <a
                href="https://maple.dev"
                class="inline-flex h-8 items-center justify-center rounded-lg border border-input bg-input/30 px-3 text-xs font-medium text-fg transition-all hover:bg-input/50"
            >
                Maple Cloud <span class="ml-1" aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </div>
</nav>

<!-- Spacer so content clears the fixed nav. -->
<div class="h-14" aria-hidden="true"></div>

<script>
    const nav = document.getElementById("main-nav");
    if (nav) {
        const update = () => {
            if (window.scrollY > 100) {
                nav.classList.add("border-foreground/15");
                nav.classList.remove("border-border");
            } else {
                nav.classList.remove("border-foreground/15");
                nav.classList.add("border-border");
            }
        };
        window.addEventListener("scroll", update, { passive: true });
        update();
    }
</script>
