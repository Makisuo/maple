---
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    ogType?: "website" | "article";
    /**
     * Locales this page actually exists in. hreflang is advertised for these
     * only — the default keeps every page announcing all three, which is what
     * every caller relied on before this prop existed.
     */
    alternates?: readonly string[];
    /**
     * Path of this page's markdown twin (`/pricing.md`), when it has one.
     * Advertised as `rel="alternate"` so an agent can find the machine-readable
     * copy without guessing the suffix. English-only — the twins are not
     * localized — so locale routes leave it unset.
     */
    mdHref?: string;
}

const {
    title = "Open Source Observability for Traces, Logs & Metrics — Maple",
    description = "Open-source observability platform for traces, logs, and metrics. Built on OpenTelemetry.",
    image = "/og-image.png",
    ogType = "website",
    alternates = ["en", "ja", "ko"],
    mdHref,
} = Astro.props;

const currentLocale = Astro.currentLocale ?? "en";
const localeMap: Record<string, string> = { en: "en_US", ja: "ja_JP", ko: "ko_KR" };
const ogLocale = localeMap[currentLocale] ?? "en_US";

// Build path without locale prefix — used for both hreflang and the canonical.
const pathWithoutLocale = Astro.url.pathname
    .replace(/^\/(ja|ko)(\/|$)/, "/")
    .replace(/\/+/g, "/");
const locales = alternates;

// Rebuilt from the locale rather than taken from Astro.url.pathname: on a page
// generated by i18n `fallbackType: "rewrite"`, pathname reports the *English*
// path, so /ko/… pages were telling Google to drop the localized URL. On a
// physical per-locale route this is a no-op.
const canonicalUrl = new URL(getRelativeLocaleUrl(currentLocale, pathWithoutLocale), Astro.site).toString();
const absoluteImage = image.startsWith("http")
    ? image
    : new URL(image, Astro.site).toString();
---

<!doctype html>
<!-- Landing is dark-only: pin the shared theme's dark class (tokens live in
     @maple/ui/styles/tokens.css; light values exist but are unused here). -->
<html lang={currentLocale} class="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="192x192" href="/logo192.png" />
        <link rel="manifest" href="/manifest.json" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#171410" />
        <meta name="robots" content="index,follow" />
        <link rel="canonical" href={canonicalUrl} />
        {locales.map((locale) => (
            <link
                rel="alternate"
                hreflang={locale}
                href={new URL(getRelativeLocaleUrl(locale, pathWithoutLocale), Astro.site).toString()}
            />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(pathWithoutLocale, Astro.site).toString()} />
        {mdHref && (
            <link rel="alternate" type="text/markdown" href={new URL(mdHref, Astro.site).toString()} />
        )}
        <link rel="dns-prefetch" href="https://cdn.brandfetch.io" />
        <link rel="preconnect" href="https://cdn.brandfetch.io" crossorigin />
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="Maple" />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={absoluteImage} />
        <meta property="og:url" content={canonicalUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@maple_dev" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImage} />
        <meta name="generator" content={Astro.generator} />
        <!-- Per-page head tags (feed discovery, preloads). Default-empty, so
             callers that don't fill it are unaffected. -->
        <slot name="head" />
        <script
            is:inline
            src="https://analytics.ahrefs.com/analytics.js"
            data-key="VKnjG071OvfESS7TIl25eA"
            async></script>
        <!-- Maple's own SDK, dogfooded. Bundled (not is:inline) so it can import
             the package; deferred by Astro, so it never blocks first paint. -->
        <script>
            import { startLandingTelemetry } from "../lib/telemetry";
            startLandingTelemetry();
        </script>
        <title>{title}</title>
    </head>
    <body class="min-h-screen antialiased">
        <slot />
        <script is:inline>
            (function() {
                if (/^\/(ja|ko)(\/|$)/.test(window.location.pathname)) return;
                if (sessionStorage.getItem('locale-redirected')) return;
                var supported = ['ja', 'ko'];
                var langs = navigator.languages || [navigator.language];
                for (var i = 0; i < langs.length; i++) {
                    var lang = langs[i].split('-')[0].toLowerCase();
                    if (supported.indexOf(lang) !== -1) {
                        sessionStorage.setItem('locale-redirected', '1');
                        window.location.replace('/' + lang + window.location.pathname);
                        return;
                    }
                }
            })();
        </script>
    </body>
</html>
