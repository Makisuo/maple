---
/**
 * LocalLoopback — the /local page's data-flow figure.
 *
 * Five stages joined by hairlines, and one line underneath saying where all of
 * it lives. Static on purpose: the docs-tuned `LocalFlow.astro` keeps its
 * compact strip, and the earlier animated return rail said the same thing the
 * caption says, louder.
 */
const nodes = [
	{ label: "OTLP exporter", sub: "your app or SDK" },
	{ label: "Ingest", sub: "POST /v1/* on :4318" },
	{ label: "Embedded store", sub: "~/.maple/data" },
	{ label: "Query API", sub: "same port" },
	{ label: "Dashboard and CLI", sub: "read it back" },
];
---

<figure class="llb" aria-label="Local mode data flow — a closed loop on localhost">
	<ol class="llb__track" role="list">
		{
			nodes.map((n, i) => (
				<Fragment>
					<li class="llb__node">
						<span class="llb__label">{n.label}</span>
						<span class="llb__sub">{n.sub}</span>
					</li>
					{i < nodes.length - 1 ? <span class="llb__wire" aria-hidden="true" /> : null}
				</Fragment>
			))
		}
	</ol>

	<figcaption class="llb__cap">
		<span class="llb__pin">127.0.0.1</span>
		One process receives your telemetry, stores it, and answers every query from the dashboard and the
		CLI. Nothing in this loop leaves your machine.
	</figcaption>
</figure>

<style>
	.llb {
		margin: 0;
		padding: 24px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		background: var(--bg-elevated);
	}
	@media (min-width: 768px) {
		.llb {
			padding: 28px 32px;
		}
	}

	.llb__track {
		display: flex;
		align-items: stretch;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.llb__node {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 3px;
		padding: 12px 14px;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg);
	}
	.llb__label {
		font-size: 13px;
		font-weight: 500;
		color: var(--foreground);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.llb__sub {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--muted-foreground);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.llb__wire {
		flex: 0 0 20px;
		align-self: center;
		height: 1px;
		background: var(--border);
	}

	.llb__cap {
		display: flex;
		align-items: baseline;
		gap: 12px;
		margin: 20px 0 0;
		font-size: 13px;
		line-height: 1.6;
		color: var(--muted-foreground);
	}
	.llb__pin {
		flex: none;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--foreground);
	}

	@media (max-width: 720px) {
		.llb__track {
			flex-direction: column;
			gap: 8px;
		}
		.llb__wire {
			display: none;
		}
		.llb__label,
		.llb__sub {
			white-space: normal;
		}
		.llb__cap {
			flex-direction: column;
			gap: 6px;
		}
	}
</style>
