---
/**
 * Kubernetes · the Helm install.
 *
 * Moved out of the old kubernetes-monitoring page. The three-dot titlebar is
 * gone; the terminal is a `.live-frame` whose head states the command.
 *
 * The copy button used to be decorative — a button that looked like it copied
 * and did nothing. It is wired now, which is the only honest option: either it
 * works or it isn't a button.
 */
import * as m from "../../../paraglide/messages.js";

const installSteps = [
	{
		caption: m.page_k8s_install_step_1(),
		code: "kubectl create namespace maple\nkubectl -n maple create secret generic maple-ingest-key \\\n  --from-literal=ingest-key=$MAPLE_INGEST_KEY",
	},
	{
		caption: m.page_k8s_install_step_2(),
		code: "helm upgrade --install maple-k8s-infra \\\n  oci://ghcr.io/makisuo/charts/maple-k8s-infra \\\n  --namespace maple \\\n  --set maple.ingestKey.existingSecret.name=maple-ingest-key \\\n  --set maple.ingestKey.existingSecret.key=ingest-key \\\n  --set global.clusterName=production",
	},
	{
		caption: m.page_k8s_install_step_3(),
		code: "kubectl -n maple rollout status daemonset/maple-k8s-infra-agent",
	},
];
---

<section class="border-t border-border bg-bg">
	<div class="shell py-16 md:py-24">
		<div class="mb-10 max-w-2xl md:mb-14">
			<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">
				{m.page_k8s_install_eyebrow()}
			</p>
			<h2
				class="mt-4 font-display text-3xl font-medium leading-[1.05] tracking-[-0.02em] text-fg md:text-[40px]"
			>
				{m.page_k8s_install_title()}
			</h2>
			<p class="mt-5 max-w-[62ch] text-sm leading-relaxed text-fg-muted md:text-[15px]">
				{m.page_k8s_install_lede()}
			</p>
		</div>

		<div class="live-frame mx-auto max-w-4xl">
			<div class="live-frame__head">
				<span>{m.page_k8s_install_window()}</span>
				<span class="tabular-nums">3 steps</span>
			</div>
			<div class="divide-y divide-border">
				{
					installSteps.map((step, i) => (
						<div class="px-5 py-4">
							<div class="mb-2.5 flex items-center gap-3">
								<span class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-border bg-bg font-mono text-[10px] tabular-nums text-fg-muted">
									{i + 1}
								</span>
								<span class="op-key">{step.caption}</span>
							</div>
							<div class="flex items-start justify-between gap-3 rounded-md border border-border bg-bg px-3.5 py-2.5">
								<pre class="m-0 min-w-0 flex-1 overflow-x-auto font-mono text-[11.5px] leading-relaxed whitespace-pre text-fg md:text-xs"><code>{step.code}</code></pre>
								<button
									type="button"
									data-copy={step.code}
									class="inline-flex shrink-0 items-center gap-1 rounded border border-border px-2 py-1 font-mono text-[10px] text-fg-muted transition-colors hover:border-input hover:text-fg"
								>
									<svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true">
										<rect
											x="9"
											y="9"
											width="11"
											height="11"
											rx="1.5"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
										/>
										<path
											d="M5 15V5a1 1 0 0 1 1-1h10"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
										/>
									</svg>
									<span data-copy-label>{m.page_k8s_install_copy()}</span>
								</button>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	import { bindCopyButtons } from "../../../lib/copy-to-clipboard";
	bindCopyButtons({
		hostSelector: "[data-copy]",
		buttonSelector: "[data-copy]",
		labelSelector: "[data-copy-label]",
		copiedLabel: "Copied",
		errorLabel: "Press ⌘C",
	});
</script>
