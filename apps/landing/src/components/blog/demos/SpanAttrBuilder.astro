---
/**
 * SpanAttrBuilder — check attributes onto a span and watch which debugging
 * questions become answerable. Pure CSS: checkboxes + `:has()`. The default
 * (no-`:has()`, no-JS) state shows the fully-attributed span with every
 * question answered, so the fallback still teaches the right lesson; the
 * @supports block makes it interactive by hiding what isn't checked.
 * Scoped classes throughout — see TraceComparison.astro.
 */

interface ToggleAttr {
	id: string;
	key: string;
	value: string;
}

const toggles: ToggleAttr[] = [
	{ id: "user", key: "app.user.id", value: "user_8f2a-4c11" },
	{ id: "tier", key: "app.user.tier", value: "enterprise" },
	{ id: "err", key: "app.error.code", value: "card_declined" },
	{ id: "flag", key: "app.flags.new_pricing", value: "true" },
	{ id: "db", key: "db.query.fingerprint", value: "f8a91" },
	{ id: "retry", key: "app.payment.attempt", value: "3" },
];

const baseAttrs = [
	{ key: "http.route", value: "/api/checkout" },
	{ key: "http.response.status_code", value: "500" },
	{ key: "duration", value: "1240ms" },
];

const questions = [
	{ n: 1, text: "Why did checkout fail for the user who just emailed support?", needs: ["user", "err"] },
	{ n: 2, text: "Did the new_pricing rollout cause the 500 spike?", needs: ["flag", "err"] },
	{ n: 3, text: "Are enterprise customers stuck in the retry path?", needs: ["tier", "retry"] },
];

const keyOf = (id: string) => toggles.find((t) => t.id === id)?.key ?? id;
---

<figure class="sab">
	<div class="sab__frame">
		<div class="sab__head">
			<span class="sab__title">build the span you'll want mid-incident</span>
		</div>

		<div class="sab__cols">
			<div class="sab__controls">
				<p class="sab__controlcap">attributes to record</p>
				{
					toggles.map((t) => (
						<label class="sab__toggle">
							<input class="sab__check" type="checkbox" id={`sab-${t.id}`} />
							<span class="sab__box" aria-hidden="true" />
							<span class="sab__togglekey">{t.key}</span>
						</label>
					))
				}
			</div>

			<div class="sab__span">
				<div class="sab__spanhead">
					<span class="sab__spantitle">the span, as your backend sees it</span>
				</div>
				<dl class="sab__attrs">
					{
						baseAttrs.map((a) => (
							<div class="sab__line sab__line--base">
								<dt class="sab__key">{a.key}</dt>
								<dd class="sab__val">{a.value}</dd>
							</div>
						))
					}
					{
						toggles.map((t) => (
							<div class:list={["sab__line", `sab__line--${t.id}`]}>
								<dt class="sab__key">{t.key}</dt>
								<dd class="sab__val">{t.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>

		<div class="sab__questions">
			{
				questions.map((q) => (
					<div class:list={["sab__q", `sab__q--${q.n}`]}>
						<p class="sab__qtext">{q.text}</p>
						<div class="sab__qmeta">
							<span class="sab__chips">
								{q.needs.map((id) => (
									<span class:list={["sab__chip", `sab__chip--${id}`]}>{keyOf(id)}</span>
								))}
							</span>
							<span class="sab__verdict">
								<span class="sab__verdict-no">not with this span</span>
								<span class="sab__verdict-yes">one filter away</span>
							</span>
						</div>
					</div>
				))
			}
		</div>
	</div>
	<figcaption class="sab__cap">
		Every question is a WHERE clause. An attribute you didn't record is a filter you don't have.
	</figcaption>
</figure>

<style>
	.sab {
		margin: 40px 0;
	}

	.sab__frame {
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
		background: color-mix(in oklab, var(--bg-elevated) 30%, transparent);
	}

	.sab__head {
		display: flex;
		align-items: center;
		padding: 9px 14px;
		background: var(--bg-elevated);
		border-bottom: 1px solid var(--border);
	}
	.sab__title {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.sab__cols {
		display: grid;
		gap: 14px;
		padding: 14px;
	}
	@media (min-width: 780px) {
		.sab__cols {
			grid-template-columns: 260px minmax(0, 1fr);
			align-items: start;
		}
	}

	/* ── Checkbox column (hidden when :has() is unavailable) ── */
	.sab__controls {
		display: none;
	}
	.sab__controlcap {
		margin: 0 0 8px;
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.sab__toggle {
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 5px 0;
		cursor: pointer;
	}
	.sab__check {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}
	.sab__box {
		flex: none;
		width: 14px;
		height: 14px;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: color-mix(in oklab, var(--bg-deep) 60%, transparent);
		transition:
			border-color 140ms ease,
			background-color 140ms ease;
		position: relative;
	}
	.sab__check:checked + .sab__box {
		border-color: var(--primary);
		background: color-mix(in oklab, var(--primary) 22%, transparent);
	}
	.sab__check:checked + .sab__box::after {
		content: "";
		position: absolute;
		inset: 3px;
		border-radius: 2px;
		background: var(--primary);
	}
	.sab__check:focus-visible + .sab__box {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	.sab__togglekey {
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--muted-foreground);
		transition: color 140ms ease;
	}
	.sab__toggle:hover .sab__togglekey {
		color: var(--foreground);
	}
	.sab__check:checked ~ .sab__togglekey {
		color: var(--foreground);
	}

	/* ── Span card ──────────────────────────────────────────── */
	.sab__span {
		border: 1px solid var(--border);
		border-radius: 8px;
		background: color-mix(in oklab, var(--bg-deep) 45%, transparent);
		overflow: hidden;
	}
	.sab__spanhead {
		padding: 8px 12px;
		border-bottom: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
	}
	.sab__spantitle {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.sab__attrs {
		margin: 0;
		padding: 8px 12px 10px;
	}
	.sab__line {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 10px;
		padding: 3px 0;
	}
	.sab__line--base .sab__key,
	.sab__line--base .sab__val {
		opacity: 0.55;
	}
	.sab__key {
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--muted-foreground);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sab__val {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--foreground);
		overflow-wrap: anywhere;
	}

	/* ── Questions ──────────────────────────────────────────── */
	.sab__questions {
		border-top: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
		padding: 12px 14px 14px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.sab__qtext {
		margin: 0 0 5px;
		font-size: 13.5px;
		line-height: 1.5;
		color: var(--foreground);
	}
	.sab__qmeta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
	}
	.sab__chips {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.sab__chip {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--primary);
		border: 1px solid color-mix(in oklab, var(--primary) 45%, transparent);
		background: color-mix(in oklab, var(--primary) 10%, transparent);
		border-radius: 4px;
		padding: 2px 7px;
		transition:
			color 140ms ease,
			border-color 140ms ease,
			background-color 140ms ease;
	}
	.sab__verdict {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.sab__verdict-no {
		display: none;
		color: color-mix(in oklab, var(--destructive) 80%, var(--muted-foreground));
	}
	.sab__verdict-yes {
		display: inline;
		color: var(--chart-3);
	}

	/* ── Interactive layer (needs :has()) ───────────────────── */
	@supports selector(:has(*)) {
		.sab__controls {
			display: block;
		}

		/* Unchecked attribute → hidden on the span card, chip goes dark. */
		.sab:not(:has(#sab-user:checked)) .sab__line--user,
		.sab:not(:has(#sab-tier:checked)) .sab__line--tier,
		.sab:not(:has(#sab-err:checked)) .sab__line--err,
		.sab:not(:has(#sab-flag:checked)) .sab__line--flag,
		.sab:not(:has(#sab-db:checked)) .sab__line--db,
		.sab:not(:has(#sab-retry:checked)) .sab__line--retry {
			display: none;
		}

		.sab:not(:has(#sab-user:checked)) .sab__chip--user,
		.sab:not(:has(#sab-tier:checked)) .sab__chip--tier,
		.sab:not(:has(#sab-err:checked)) .sab__chip--err,
		.sab:not(:has(#sab-flag:checked)) .sab__chip--flag,
		.sab:not(:has(#sab-db:checked)) .sab__chip--db,
		.sab:not(:has(#sab-retry:checked)) .sab__chip--retry {
			color: var(--muted-foreground);
			border-color: var(--border);
			background: transparent;
		}

		/* Any missing requirement flips the verdict back to "not answerable". */
		.sab:not(:has(#sab-user:checked)) .sab__q--1 .sab__verdict-yes,
		.sab:not(:has(#sab-err:checked)) .sab__q--1 .sab__verdict-yes,
		.sab:not(:has(#sab-flag:checked)) .sab__q--2 .sab__verdict-yes,
		.sab:not(:has(#sab-err:checked)) .sab__q--2 .sab__verdict-yes,
		.sab:not(:has(#sab-tier:checked)) .sab__q--3 .sab__verdict-yes,
		.sab:not(:has(#sab-retry:checked)) .sab__q--3 .sab__verdict-yes {
			display: none;
		}
		.sab:not(:has(#sab-user:checked)) .sab__q--1 .sab__verdict-no,
		.sab:not(:has(#sab-err:checked)) .sab__q--1 .sab__verdict-no,
		.sab:not(:has(#sab-flag:checked)) .sab__q--2 .sab__verdict-no,
		.sab:not(:has(#sab-err:checked)) .sab__q--2 .sab__verdict-no,
		.sab:not(:has(#sab-tier:checked)) .sab__q--3 .sab__verdict-no,
		.sab:not(:has(#sab-retry:checked)) .sab__q--3 .sab__verdict-no {
			display: inline;
		}
	}

	.sab__cap {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted-foreground);
		margin-top: 10px;
	}
</style>
