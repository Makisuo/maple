---
/**
 * OpsListSimulator — what an operations list (GROUP BY span name) degenerates
 * into under the two naming failure modes, vs healthy template names. The bad
 * views use the real numbers from our own production audit. CSS-only: radio
 * three-way + `:has()`; browsers without `:has()` get all three tables
 * stacked. Scoped classes throughout — see TraceComparison.astro.
 */

interface OpRow {
	name: string;
	count: number;
	p95: string | null; // null → percentile is meaningless in this view
}

interface View {
	id: string;
	label: string;
	rows: OpRow[];
	footer?: string;
	note: string;
}

const views: View[] = [
	{
		id: "closet",
		label: "one name for everything",
		rows: [{ name: "executeSql", count: 222632, p95: "395ms" }],
		note: "One row, 222,632 spans, ~200,000 distinct queries underneath it. The slowest operation in the service can never appear in this list: the grouping key doesn't know it exists.",
	},
	{
		id: "leak",
		label: "values leaked into names",
		rows: [
			{ name: "invoke_agent hypothesis-unknown_ingest_keys_are_the_spike_source", count: 2, p95: null },
			{ name: "invoke_agent hypothesis-r2_returned_transient_internal_failures", count: 1, p95: null },
			{ name: "invoke_agent hypothesis-the_aggregation_query_deterministically_ooms", count: 1, p95: null },
			{ name: "invoke_agent hypothesis-clickhouse_connection_pool_exhaustion", count: 3, p95: null },
			{ name: "invoke_agent hypothesis-cursor_pagination_replay_mismatch", count: 1, p95: null },
			{ name: "invoke_agent hypothesis-sampling_config_change_dropped_spans", count: 2, p95: null },
			{ name: "invoke_agent hypothesis-billing_entitlement_cache_stampede", count: 1, p95: null },
			{ name: "invoke_agent hypothesis-wal_lane_compaction_stall", count: 1, p95: null },
		],
		footer: "… 319 more names, used once or twice",
		note: "555 spans minted 327 operation names. Nothing aggregates, nothing trends, nothing alerts, and every p95 is the p95 of one call.",
	},
	{
		id: "healthy",
		label: "class-of-work names",
		rows: [
			{ name: "SELECT spans_minutely", count: 84210, p95: "88ms" },
			{ name: "SELECT service_overview", count: 41880, p95: "61ms" },
			{ name: "SELECT org_config", count: 26110, p95: "17.7ms" },
			{ name: "SELECT trace_detail", count: 22342, p95: "212ms" },
			{ name: "INSERT alert_checks", count: 18904, p95: "34ms" },
			{ name: "SELECT logs_search", count: 12671, p95: "1,100ms" },
			{ name: "SELECT sessions_list", count: 9113, p95: "143ms" },
			{ name: "SELECT error_issues", count: 7402, p95: "96ms" },
		],
		footer: "… 14 more operations",
		note: "One row per class of work. Same spans as the first view, but now the 1.1s operation is the second thing you look at instead of a rounding error inside an average.",
	},
];

const fmt = new Intl.NumberFormat("en-US");
---

<figure class="ops">
	<div class="ops__frame">
		<div class="ops__head">
			<span class="ops__title">operations · GROUP BY span_name · last 24h</span>
		</div>

		<div class="ops__rail" role="radiogroup" aria-label="Naming strategy">
			{
				views.map((v, i) => (
					<label class="ops__opt">
						<input class="ops__radio" type="radio" name="ops-mode" id={`ops-${v.id}`} checked={i === 0} />
						<span class="ops__optlabel">{v.label}</span>
					</label>
				))
			}
		</div>

		{
			views.map((v) => {
				const max = Math.max(...v.rows.map((r) => r.count));
				return (
					<div class:list={["ops__panel", `ops__panel--${v.id}`]}>
						<p class="ops__panelcap">{v.label}</p>
						<div class="ops__scroll">
							<div class="ops__table">
								<div class="ops__tr ops__tr--header">
									<span class="ops__th">span name</span>
									<span class="ops__th ops__th--num">spans</span>
									<span class="ops__th">volume</span>
									<span class="ops__th ops__th--num">p95</span>
								</div>
								{v.rows.map((r) => (
									<div class="ops__tr">
										<span class="ops__name">{r.name}</span>
										<span class="ops__count">{fmt.format(r.count)}</span>
										<span class="ops__barcell">
											<span
												class="ops__bar"
												style={`width:${Math.max((r.count / max) * 100, 0.75)}%`}
											/>
										</span>
										<span class:list={["ops__p95", r.p95 === null && "ops__p95--void"]}>
											{r.p95 ?? "p95 of 1 call"}
										</span>
									</div>
								))}
								{v.footer && <div class="ops__tr ops__tr--footer">{v.footer}</div>}
							</div>
						</div>
						<p class="ops__note">{v.note}</p>
					</div>
				);
			})
		}
	</div>
	<figcaption class="ops__cap">
		The same query engine ran all three. Only the grouping key changed.
	</figcaption>
</figure>

<style>
	.ops {
		margin: 40px 0;
	}

	.ops__frame {
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
		background: color-mix(in oklab, var(--bg-elevated) 30%, transparent);
	}

	.ops__head {
		display: flex;
		align-items: center;
		padding: 9px 14px;
		background: var(--bg-elevated);
		border-bottom: 1px solid var(--border);
	}
	.ops__title {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	/* ── Toggle rail (hidden when :has() is unavailable) ─────── */
	.ops__rail {
		display: none;
		flex-wrap: wrap;
		gap: 8px;
		padding: 12px 14px 0;
	}
	.ops__radio {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}
	.ops__optlabel {
		display: inline-flex;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted-foreground);
		background: color-mix(in oklab, var(--bg-elevated) 45%, transparent);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 6px 11px;
		cursor: pointer;
		transition:
			color 140ms ease,
			border-color 140ms ease,
			background-color 140ms ease;
	}
	.ops__opt:hover .ops__optlabel {
		color: var(--foreground);
		border-color: color-mix(in oklab, var(--muted-foreground) 50%, var(--border));
	}
	.ops__radio:checked + .ops__optlabel {
		color: var(--foreground);
		border-color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
	}
	.ops__radio:focus-visible + .ops__optlabel {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	/* ── Panels ─────────────────────────────────────────────── */
	.ops__panel {
		padding: 10px 6px 0;
	}
	.ops__panelcap {
		display: block;
		margin: 0 8px 4px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	@supports selector(:has(*)) {
		.ops__rail {
			display: flex;
		}
		.ops__panelcap {
			display: none;
		}
		.ops:has(#ops-closet:checked) .ops__panel--leak,
		.ops:has(#ops-closet:checked) .ops__panel--healthy,
		.ops:has(#ops-leak:checked) .ops__panel--closet,
		.ops:has(#ops-leak:checked) .ops__panel--healthy,
		.ops:has(#ops-healthy:checked) .ops__panel--closet,
		.ops:has(#ops-healthy:checked) .ops__panel--leak {
			display: none;
		}
	}

	.ops__scroll {
		overflow-x: auto;
	}
	.ops__table {
		min-width: 620px;
	}

	/* ── Table rows ─────────────────────────────────────────── */
	.ops__tr {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) 8ch minmax(0, 0.6fr) 11ch;
		align-items: center;
		gap: 12px;
		padding: 6px 10px;
		border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
	}
	.ops__tr:last-child {
		border-bottom: none;
	}
	.ops__tr--header {
		padding-top: 2px;
	}
	.ops__th {
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.ops__th--num {
		text-align: right;
	}
	.ops__name {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--foreground);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.ops__count {
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--muted-foreground);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.ops__barcell {
		height: 8px;
		background: color-mix(in oklab, var(--bg-elevated) 80%, transparent);
		border-radius: 2px;
		overflow: hidden;
	}
	.ops__bar {
		display: block;
		height: 100%;
		background: color-mix(in oklab, var(--primary) 75%, transparent);
		border-radius: 2px;
		transition: width 300ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.ops__p95 {
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--muted-foreground);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.ops__p95--void {
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: color-mix(in oklab, var(--destructive) 75%, var(--muted-foreground));
	}
	.ops__tr--footer {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--muted-foreground);
		font-style: italic;
	}

	.ops__note {
		margin: 10px 8px 0;
		padding: 8px 10px 12px;
		font-size: 13px;
		line-height: 1.6;
		color: var(--muted-foreground);
		border-top: 1px dashed color-mix(in oklab, var(--border) 80%, transparent);
	}

	.ops__cap {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted-foreground);
		margin-top: 10px;
	}

	@media (prefers-reduced-motion: reduce) {
		.ops__bar {
			transition: none;
		}
	}
</style>
