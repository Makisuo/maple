---
/**
 * Homepage section — Alerting.
 * Centered "stage" layout (like the Kubernetes section): eyebrow pill,
 * gradient heading, the firing-incident artifact, a row of every supported
 * notification destination, and a 3-card feature strip.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import LiveAlertFeed from "./live/LiveAlertFeed.astro";
import * as m from "../paraglide/messages";

const locale = Astro.currentLocale ?? "en";
const featurePath = getRelativeLocaleUrl(locale, "/features/alerting");

const features = [
	{ title: m.alert_rules_title(), desc: m.alert_rules_desc() },
	{ title: m.alert_route_title(), desc: m.alert_route_desc() },
	{ title: m.alert_incidents_title(), desc: m.alert_incidents_desc() },
];
---

<section class="relative bg-bg-deep overflow-hidden">
	<!-- Subtle dot-grid backdrop, faded toward the edges. -->
	<div
		class="absolute inset-0 pointer-events-none"
		aria-hidden="true"
		style="
			background-image: radial-gradient(oklch(1 0 0 / 5%) 1px, transparent 1px);
			background-size: 22px 22px;
			mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black, transparent 78%);
			-webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black, transparent 78%);
		"
	></div>

	<div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32">
		<!-- Centered prose stage. -->
		<div class="mx-auto max-w-2xl text-center">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-[0.14em] text-fg-muted"
			>
				<span class="inline-block size-1.5 rounded-full bg-primary"></span>
				{m.alert_badge()}
			</span>

			<h2
				class="mt-4 font-display text-3xl sm:text-4xl md:text-5xl font-semibold leading-[1.04] tracking-tight text-gradient-accent"
			>
				{m.alert_heading()}
			</h2>
			<p class="mx-auto mt-5 text-sm md:text-base text-fg-muted leading-relaxed max-w-lg">
				{m.alert_lede()}
			</p>

			<div class="mt-7 flex justify-center text-[12.5px]">
				<a
					href={featurePath}
					class="text-fg hover:text-primary transition-colors border-b border-border hover:border-primary pb-0.5"
				>
					{m.cta_learn_more()}
				</a>
			</div>
		</div>

		<!-- Incident artifact with a soft glow underneath. -->
		<div class="relative mt-14 md:mt-16 mx-auto max-w-2xl">
			<div
				class="absolute inset-0 pointer-events-none -z-10"
				aria-hidden="true"
				style="box-shadow: 0 0 160px 32px oklch(0.70 0.16 60 / 0.08);"
			></div>
			<LiveAlertFeed />
		</div>

		<!-- Every supported destination. -->
		<div class="mt-12 flex flex-wrap justify-center gap-3">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-[12px] text-fg-muted"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="#E8C5EA" aria-hidden="true">
					<path
						d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"
					/>
				</svg>
				Slack
			</span>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-[12px] text-fg-muted"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="#C7CDFF" aria-hidden="true">
					<path
						d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
					/>
				</svg>
				Discord
			</span>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-[12px] text-fg-muted"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
					<path d="M4 6h16v12H4z" stroke="#E8872A" stroke-width="1.8" stroke-linejoin="round" />
					<path d="m4 7 8 6 8-6" stroke="#E8872A" stroke-width="1.8" stroke-linejoin="round" />
				</svg>
				{m.alert_dest_email()}
			</span>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-[12px] text-fg-muted"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="#06AC38" aria-hidden="true">
					<path
						d="M16.965 1.18C15.085.164 13.769 0 10.683 0H3.73v14.55h6.926c2.743 0 4.8-.164 6.61-1.37 1.975-1.303 3.004-3.484 3.004-6.007 0-2.716-1.262-4.896-3.305-5.994zm-5.5 10.326h-4.21V3.113l3.977-.027c3.62-.028 5.43 1.234 5.43 4.128 0 3.113-2.248 4.292-5.197 4.292zM3.73 17.61h3.525V24H3.73z"
					/>
				</svg>
				PagerDuty
			</span>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-[12px] text-fg-muted"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
					<path d="M8 6c-2 0-2 2-2 3s0 3-3 3c3 0 3 2 3 3s0 3 2 3M16 6c2 0 2 2 2 3s0 3 3 3c-3 0-3 2-3 3s0 3-2 3" stroke="#F59E0B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				{m.alert_dest_webhook()}
			</span>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-[12px] text-fg-muted"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 266 219" width="15" height="15" fill="#F46F0F" aria-hidden="true">
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M155 124.5C167.16 122 187.95 109.3 194.35 96.5H194.35C186.18 82.16 159.85 55 119.85 61C117.85 55.83 111.35 43.4 101.35 35C89.35 43 36.85 167.5 93.35 219C65.35 210.16 7.65 178.6 0.85 123C-7.64 53.5 48.85 8.5 98.85 8.5C113.44 8.5 132.42 10.75 151.99 13.08C199.45 18.73 250.35 24.78 250.35 0C270.18 29 289 137.5 172.5 183.5C172.84 182.02 173.22 180.49 173.61 178.92C177.93 161.62 183.42 139.63 155 124.5ZM146 88.5C146 93.19 142.19 97 137.5 97C132.80 97 129 93.19 129 88.5C129 83.80 132.80 80 137.5 80C142.19 80 146 83.80 146 88.5ZM120.78 136.70C92.00 138.35 87.77 156.55 89.25 165.44C89.25 169.30 95.96 172.51 102.08 175.45C107.69 178.13 112.82 180.59 111.89 183.10C109.95 188.35 100.57 188.57 96.12 188.03C99.90 198.70 111.00 219.39 125.23 216.77C139.46 214.14 150.02 196.51 153.53 188.03C149.49 188.85 137.76 186.38 137.76 181.46C137.76 179.71 140.55 178.54 144.14 177.01C150.71 174.23 160 170.31 160 159.70C159.03 139.99 136.95 135.33 126.04 135.47C128.30 127.59 134.80 124.25 137.76 123.56C136.79 118.97 132.78 117.27 130.89 117C123.45 122.58 121.05 132.46 120.78 136.70Z"
					/>
				</svg>
				Hazel
			</span>
		</div>
		<p class="mt-3 text-center text-[11px] text-fg-muted">{m.alert_webhook_note()}</p>

		<!-- Feature strip. -->
		<div
			class="mt-12 md:mt-16 overflow-hidden rounded-xl grid grid-cols-1 md:grid-cols-3 gap-px bg-border border border-border"
		>
			{
				features.map((f) => (
					<div class="bg-bg-deep p-6 md:p-7">
						<h3 class="text-[15px] font-semibold text-fg mb-2 leading-snug">{f.title}</h3>
						<p class="text-[13px] text-fg-muted leading-relaxed">{f.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
