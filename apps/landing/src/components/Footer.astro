---
import { getRelativeLocaleUrl } from "astro:i18n";
import * as m from "../paraglide/messages.js";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getGitHubStars, formatStars } from "../lib/github-stars";
import { features } from "../lib/features";
import { featurePath } from "../lib/page-registry";
import { MapleMark } from "@maple/ui/components/icons/maple-mark";

const locale = Astro.currentLocale ?? "en";
const l = (path: string) => getRelativeLocaleUrl(locale, path);
const stars = await getGitHubStars();
---

<footer class="border-t border-border bg-bg-deep">
    <!-- Manifesto line. Capped at 20ch so it breaks into three lines — one
         refusal per line. That break is the whole gesture. -->
    <div class="border-b border-border">
        <div class="shell py-16 md:py-24">
            <p class="font-display text-3xl md:text-5xl font-medium text-foreground leading-[1.1] max-w-[20ch] tracking-[-0.02em]">
                {m.footer_manifesto()}
            </p>
        </div>
    </div>

    <div class="shell py-12">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 lg:gap-12">
            <!-- Col 1: Logo + tagline -->
            <div class="col-span-2 md:col-span-3 lg:col-span-2">
                <div class="flex items-center gap-2.5 mb-4">
                    <MapleMark size={26} className="text-primary shrink-0" />
                    <span class="text-foreground text-sm font-medium">Maple</span>
                </div>
                <p class="text-fg-muted text-xs leading-relaxed max-w-xs">
                    {m.footer_tagline()}
                </p>
            </div>

            <!-- Col 2: Product -->
            <div>
                <h4 class="text-[10px] text-foreground font-medium uppercase tracking-wider mb-4">{m.footer_product()}</h4>
                <ul class="space-y-2">
                    <!-- These two anchors were dead until the homepage rebuild:
                         no page carried #features or #how-it-works. They now
                         point at the platform sheet and the incident story. -->
                    <li><a href={`${l("/")}#features`} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_features()}</a></li>
                    <li><a href={`${l("/")}#how-it-works`} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_how_it_works()}</a></li>
                    <li><a href={l("/pricing")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_pricing()}</a></li>
                    <li><a href={l("/opentelemetry")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_opentelemetry()}</a></li>
                    <li><a href={l("/roadmap")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_roadmap()}</a></li>
                    <li><a href={l("/local")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_local()}</a></li>
                    <li><a href="/docs" class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_docs()}</a></li>
                    <li><a href="/guides" class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_guides()}</a></li>
                    <li><a href="/blog" class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_blog()}</a></li>
                    <!-- English-only, like /docs and /blog above: bare href, not l(). -->
                    <li><a href="/changelog" class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_changelog()}</a></li>
                </ul>
            </div>

            <!-- Col 3: Features -->
            <div>
                <h4 class="text-[10px] text-foreground font-medium uppercase tracking-wider mb-4">{m.footer_features()}</h4>
                <ul class="space-y-2">
                    <!-- Derived from the registry. The hand-written list carried
                         seven of the eight features — browser-sessions had been
                         missing since it shipped. -->
                    {features.map((feature) => (
                        <li><a href={featurePath(locale, feature.slug)} class="text-fg-muted text-xs hover:text-foreground transition-colors">{feature.navLabel()}</a></li>
                    ))}
                </ul>
            </div>

            <!-- Col 4: Compare -->
            <div>
                <h4 class="text-[10px] text-foreground font-medium uppercase tracking-wider mb-4">{m.footer_compare()}</h4>
                <ul class="space-y-2">
                    <li><a href={l("/compare/datadog")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_vs_datadog()}</a></li>
                    <li><a href={l("/compare/grafana")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_vs_grafana()}</a></li>
                    <li><a href={l("/compare/new-relic")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_vs_new_relic()}</a></li>
                    <li><a href={l("/compare/dash0")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_vs_dash0()}</a></li>
                </ul>

                <h4 class="text-[10px] text-foreground font-medium uppercase tracking-wider mb-4 mt-6">{m.footer_integrations()}</h4>
                <ul class="space-y-2">
                    <li><a href={l("/integrations/nextjs")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_nextjs()}</a></li>
                    <li><a href={l("/integrations/python")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_python()}</a></li>
                    <li><a href={l("/integrations/nodejs")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.nav_nodejs()}</a></li>
                </ul>
            </div>

            <!-- Col 5: Community -->
            <div>
                <h4 class="text-[10px] text-foreground font-medium uppercase tracking-wider mb-4">{m.footer_community()}</h4>
                <ul class="space-y-2">
                    <!-- GitHub keeps its text row for the star count; X and
                         Discord move to icons in the bottom bar, so they aren't
                         listed twice. -->
                    <li><a href="https://github.com/Makisuo/maple" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_github()}{stars != null && <span class="tabular-nums">{formatStars(stars)}</span>}</a></li>
                    <li><a href="https://opentelemetry.io" target="_blank" rel="noopener noreferrer" class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_opentelemetry()}</a></li>
                </ul>

                <h4 class="text-[10px] text-foreground font-medium uppercase tracking-wider mb-4 mt-6">{m.footer_learn()}</h4>
                <ul class="space-y-2">
                    <li><a href="/guides/what-is-apm" class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_what_is_apm()}</a></li>
                    <li><a href={l("/observability")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_what_is_observability()}</a></li>
                    <li><a href={l("/best-open-source-observability-tools")} class="text-fg-muted text-xs hover:text-foreground transition-colors">{m.footer_best_tools()}</a></li>
                </ul>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-12 pt-6 border-t border-border flex flex-col sm:flex-row items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <p class="text-fg-muted text-[10px]">{m.footer_copyright()}</p>
                <!-- A licence stamp is exactly the register this footer wants. -->
                <span class="rounded border border-border px-1.5 py-0.5 text-[10px] text-fg-muted">{m.bill_v_apache()}</span>
            </div>
            <div class="flex items-center gap-4">
                <a href={l("/privacy")} class="text-fg-muted text-[10px] hover:text-foreground transition-colors">{m.footer_privacy()}</a>
                <a href={l("/terms")} class="text-fg-muted text-[10px] hover:text-foreground transition-colors">{m.footer_terms()}</a>
                <!-- English-only page, so a bare href rather than l() — same as
                     /changelog and /docs above. -->
                <a href="/brand" class="text-fg-muted text-[10px] hover:text-foreground transition-colors">{m.footer_brand()}</a>
                <LanguageSwitcher />
                <div class="flex items-center gap-3 border-l border-border pl-4">
                    <a href="https://github.com/Makisuo/maple" target="_blank" rel="noopener noreferrer" aria-label={m.footer_github()} class="text-fg-muted hover:text-foreground transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
                    </a>
                    <a href="https://x.com/maple_dev" target="_blank" rel="noopener noreferrer" aria-label={m.footer_twitter()} class="text-fg-muted hover:text-foreground transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" /></svg>
                    </a>
                    <a href="https://discord.gg/BnXjKuwJqP" target="_blank" rel="noopener noreferrer" aria-label={m.footer_discord()} class="text-fg-muted hover:text-foreground transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" /></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</footer>
