---
import { getRelativeLocaleUrl } from "astro:i18n";

interface BreadcrumbItem {
    label: string;
    href?: string;
}

interface Props {
    items: BreadcrumbItem[];
    /** Container classes. Pages on the `.shell` grid pass "shell pt-4" so the
     *  trail lines up with the nav above it instead of sitting 72px narrower. */
    class?: string;
}

const { items, class: className = "mx-auto max-w-6xl px-6 pt-4" } = Astro.props;
const locale = Astro.currentLocale ?? "en";
const l = (path: string) => getRelativeLocaleUrl(locale, path);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://maple.dev';
// Astro.url.pathname reports the *English* path on a fallback-rewritten locale
// route, so the leaf of a /ja or /ko trail would otherwise point at the English
// URL. Rebuild it from the locale instead.
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(ja|ko)(\/|$)/, '/').replace(/\/+/g, '/');
const currentUrl = `${siteUrl}${l(pathWithoutLocale)}`;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": items.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.label,
        "item": item.href ? `${siteUrl}${l(item.href)}` : currentUrl,
    })),
};
---

<nav aria-label="Breadcrumb" class={className}>
    <ol class="flex items-center gap-1.5 text-[11px]">
        {items.map((item, index) => (
            <li class="flex items-center gap-1.5">
                {index > 0 && <span class="text-fg-muted">/</span>}
                {item.href ? (
                    <a href={l(item.href)} class="text-fg-muted hover:text-fg transition-colors">{item.label}</a>
                ) : (
                    <span class="text-fg">{item.label}</span>
                )}
            </li>
        ))}
    </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
