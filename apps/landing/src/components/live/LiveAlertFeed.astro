---
/**
 * LiveAlertFeed — a firing alert incident, frozen mid-page.
 * Fully SSR'd (no client island): an alert is a single moment in time, so a
 * static card reads better than a loop. The only motion is a CSS pulse on the
 * severity dot, gated on prefers-reduced-motion.
 */
import * as m from "../../paraglide/messages";
---

<div class="live-frame">
	<div class="live-frame__head">
		<span>alerts · incident feed</span>
		<span class="live-frame__live">
			<span class="live-frame__live-dot"></span>
			LIVE
		</span>
	</div>

	<div class="p-4 text-[12.5px] leading-[1.55]">
		<!-- Severity row -->
		<div class="flex flex-wrap items-center gap-2.5">
			<span class="alert-pulse-dot" aria-hidden="true"></span>
			<span
				class="inline-flex items-center rounded-full border border-red-500/40 bg-red-500/10 px-2 py-0.5 text-[10px] font-medium uppercase tracking-[0.14em] text-red-400"
			>
				{m.alert_firing()}
			</span>
			<span class="text-[11px] text-fg-muted">{m.alert_triggered_ago()}</span>
		</div>

		<!-- Rule line -->
		<div class="mt-3 text-fg">
			payments · error rate &gt; 2% for 5m
			<span class="text-fg-muted">·</span>
			<span class="tabular-nums text-red-400">4.7%</span>
			<span class="text-[11.5px] text-fg-muted tabular-nums">(threshold 2%)</span>
		</div>

		<!-- Attached context: the "context attached" promise -->
		<div class="mt-3 grid gap-1 text-[11.5px] text-fg-muted border-t border-border pt-2.5">
			<div>top endpoint: <span class="text-fg">POST /v1/charges</span> · 142 errors</div>
			<div>sample trace: <span class="text-primary">trace_9f3c</span> · order 8421</div>
			<div>group: <span class="text-fg">region=eu-west-1</span> · 1 of 3 groups firing</div>
		</div>

		<!-- Actions -->
		<div class="mt-4 flex flex-wrap gap-2">
			<span
				class="inline-flex items-center rounded-md border border-border bg-bg-elevated px-2.5 py-1 text-[11.5px] text-fg"
			>
				{m.alert_view()}
			</span>
			<span
				class="inline-flex items-center rounded-md border border-border px-2.5 py-1 text-[11.5px] text-fg-muted"
			>
				{m.alert_acknowledge()}
			</span>
		</div>

		<!-- Delivery log -->
		<div class="mt-4 grid gap-1 text-[11.5px] text-fg-muted border-t border-border pt-2.5">
			<div><span class="text-primary">→</span> slack <span class="text-fg">#incidents</span> · 200 OK</div>
			<div><span class="text-primary">→</span> pagerduty · incident opened</div>
		</div>
	</div>

	<div
		class="px-3.5 py-2.5 border-t border-border bg-bg-elevated text-[10px] uppercase tracking-wider text-fg-muted flex justify-between gap-4"
	>
		<span>1 firing · 12 resolved this week</span>
		<span>{m.alert_ai_note()}</span>
	</div>
</div>

<style>
	.alert-pulse-dot {
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: oklch(0.65 0.22 25);
	}
	@media (prefers-reduced-motion: no-preference) {
		.alert-pulse-dot {
			animation: alert-pulse 1.6s ease-in-out infinite;
		}
		@keyframes alert-pulse {
			0%,
			100% {
				box-shadow: 0 0 0 0 oklch(0.65 0.22 25 / 0.5);
			}
			50% {
				box-shadow: 0 0 0 6px oklch(0.65 0.22 25 / 0);
			}
		}
	}
</style>
