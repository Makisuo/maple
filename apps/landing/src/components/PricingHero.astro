---
/**
 * The pricing page's hero.
 *
 * Shares FeatureHero's shell (grid backdrop, container, badge) so /pricing
 * still reads as one of the site's pages, but carries three things the generic
 * hero can't: the claims a buyer scans for before anything else ("no per-seat",
 * "no per-host", "no per-series"), a second CTA that jumps straight to the
 * estimator, and the rate card — every signal's rate and retention on one
 * line, above the fold, before the offer card asks for a decision.
 *
 * Every number comes from `getOffer()`; nothing here is typed by hand.
 */
import { buttonVariants } from "@maple/ui/components/ui/button";
import * as m from "../paraglide/messages.js";
import { HeroCta } from "./HeroCta";
import { getOffer, money, rateBlock, rateLabel, volume, type Allotment } from "../lib/pricing-offer";

const offer = await getOffer();

// The hero quotes one included volume and one per-GB rate; the three GB
// signals share both, so any of them is the source. Fall back to the first
// allotment so a config drift renders a number rather than "undefined".
const gbSignal = offer.allotments.find((a) => a.unit === "gb") ?? offer.allotments[0];
const includedGB = gbSignal?.included ?? 0;
const gbRate = gbSignal?.rate ?? 0;

// Same sentence templates as the offer card so the two never disagree.
const RATE_SLOT = "%RATE%";
const rateSentence = (a: Allotment): string => {
	if (a.unlimited) return m.pricing_free_beta();
	if (a.rate === undefined) return "";
	const rendered =
		a.unit === "gb"
			? m.pricing_rate_gb({ rate: RATE_SLOT })
			: a.unit === "sessions"
				? m.pricing_rate_session({ rate: RATE_SLOT })
				: m.pricing_rate_events({ rate: RATE_SLOT, block: rateBlock(a) });
	return rendered.replace(RATE_SLOT, rateLabel(a.rate));
};

const claims = [m.pricing_no_seat(), m.pricing_no_host(), m.pricing_no_series()];
const RETENTION_DAYS = 30;
---

<section class="relative overflow-hidden pt-[19px]">
	<div
		class="pointer-events-none absolute inset-0"
		style="
        background-image:
            linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px),
            linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse 70% 50% at 50% 30%, black, transparent);
    "
	>
	</div>

	<div class="relative mx-auto max-w-6xl px-6 pb-16 pt-24 md:pb-20 md:pt-32">
		<div class="mb-6">
			<span
				class="inline-flex items-center rounded-full border border-border bg-card px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-primary"
			>
				{m.page_pricing_label()}
			</span>
		</div>

		<h1
			class="max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight text-fg sm:text-4xl md:text-5xl"
		>
			{m.pricing_hero_title()}
		</h1>

		<p class="mt-5 max-w-2xl text-sm leading-relaxed text-fg-muted md:text-base">
			{
				m.pricing_hero_lede({
					price: money(offer.price),
					included: String(includedGB),
					rate: rateLabel(gbRate),
				})
			}
		</p>

		{/* The three claims a buyer scans for. Plain rows, one check each. */}
		<ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-fg">
			{
				claims.map((claim) => (
					<li class="inline-flex items-center gap-2">
						<svg
							class="h-3.5 w-3.5 shrink-0 text-primary"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
						>
							<path d="M20 6L9 17l-5-5" />
						</svg>
						{claim}
					</li>
				))
			}
		</ul>

		<div class="mt-8 flex flex-wrap items-center gap-3">
			<HeroCta client:load className={buttonVariants({ size: "default" })} />
			<a href="#calculator" class={buttonVariants({ variant: "outline", size: "default" })}>
				{m.pricing_hero_estimate()}
			</a>
		</div>

		{/* The rate card. One cell per metered signal: label, rate, then what's
		    included. This is the whole price list; the offer card below repeats
		    it only to attach the plan and the button. */}
		<div class="mt-14 md:mt-16">
			<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">
				{m.pricing_rates_eyebrow()}
			</p>
			<div
				class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-5"
			>
				{
					offer.allotments.map((a) => (
						<div class="bg-bg p-5">
							<div class="text-[12.5px] text-fg">{a.label}</div>
							<div class="mt-3 flex items-baseline gap-1.5">
								{a.unlimited ? (
									<span class="font-mono text-2xl tabular-nums tracking-[-0.02em] text-fg">
										{m.pricing_unlimited()}
									</span>
								) : (
									<>
										<span class="font-mono text-2xl tabular-nums tracking-[-0.02em] text-fg">
											{a.rate === undefined ? "—" : rateLabel(a.rate)}
										</span>
										<span class="font-mono text-[11px] text-fg-muted">
											{a.unit === "gb"
												? "/ GB"
												: a.unit === "sessions"
													? "/ session"
													: `/ ${rateBlock(a)} events`}
										</span>
									</>
								)}
							</div>
							<div class="mt-2 text-[11.5px] text-fg-muted">
								{a.unlimited
									? rateSentence(a)
									: m.pricing_rate_included({ amount: volume(a, a.included) })}
							</div>
						</div>
					))
				}
			</div>
			<p class="mt-4 max-w-[80ch] text-[12px] leading-relaxed text-fg-muted">
				{m.pricing_rates_retention({ days: String(RETENTION_DAYS) })}
			</p>
		</div>
	</div>
</section>
