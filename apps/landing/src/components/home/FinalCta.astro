---
/**
 * The bookend CTA — PEAK 2, and the page's full stop.
 *
 * Extracted from inside Quickstart.astro, where it was nested in the same
 * <section> as the SDK tabs and therefore couldn't be reordered.
 *
 * Centred, unlike every other section on the page. Centring reads as a
 * marketing shrug mid-page but as a full stop at the end, and this is the one
 * place the left axis should break.
 */
import * as m from "../../paraglide/messages.js";
import { APP_SIGN_UP_URL } from "../../lib/app-urls";

// The command is markup (a <code>), not text, so the message carries a slot
// for it and every locale keeps its own word order around it. Same sentinel
// trick PricingTable uses for its rate amounts.
const CMD_SLOT = "%CMD%";
const [ledeBefore, ledeAfter = ""] = m.cta_bookend_lede({ cmd: CMD_SLOT }).split(CMD_SLOT);
---

<section class="relative overflow-hidden drenched-amber">
	<div class="relative shell py-32 text-center md:py-40">
		<h2
			class="mx-auto max-w-[24ch] font-display text-4xl font-medium leading-[1.04] tracking-[-0.02em] sm:text-5xl md:text-6xl"
		>
			{m.cta_bookend_title()}
		</h2>
		<p class="mx-auto mt-5 max-w-[52ch] text-base leading-relaxed opacity-85 md:text-lg">
			{ledeBefore}<code class="rounded bg-primary-foreground/10 px-1.5 py-0.5 text-[0.9em]">maple start</code>{ledeAfter}
		</p>
		<!-- Ink on amber, not cream on amber: a cream fill next to the outline
		     button read as the disabled one. -->
		<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
			<a
				href={APP_SIGN_UP_URL}
				class="ink-button inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium transition-colors"
			>
				{m.cta_bookend_primary()}
			</a>
			<a
				href="https://github.com/MapleTechLabs/maple"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-11 items-center justify-center rounded-lg border border-current/40 px-5 text-sm font-medium transition-colors hover:bg-current/10"
			>
				{m.cta_bookend_secondary()}
			</a>
		</div>
	</div>
</section>
