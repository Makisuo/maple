---
/**
 * 02 · Incident — the pinned-pane walkthrough. The page's centrepiece.
 *
 * One narrative carries alert → trace → logs → agent, so the page doesn't need
 * four separate sections for them. Left column scrolls through four steps; the
 * right pane pins and swaps its plate as each step reaches the middle of the
 * viewport.
 *
 * Mechanics: `self-start` on the sticky grid item is mandatory — a grid item
 * defaults to `align-self: stretch`, which silently kills `position: sticky`.
 * `data-active="1"` ships in the markup so pane 1 is lit before any JS runs,
 * and the whole thing degrades to a plain four-item list under reduced motion
 * (rules live with the other freeze rules in global.css).
 */
import * as m from "../../paraglide/messages";
import MediaFrame from "./MediaFrame.astro";

const steps = [
	{
		title: m.incident_step_1_title(),
		body: m.incident_step_1_body(),
		shot: "An alert rule with its threshold, evaluation window and firing history",
		src: "/screenshots/flow-01-alert.webp",
	},
	{
		// The step title is the trace section's headline, reused verbatim.
		title: m.trace_title(),
		body: m.incident_step_2_body(),
		shot: "A span selected in the waterfall with its full attribute set open alongside",
		src: "/screenshots/flow-02-trace.webp",
	},
	{
		title: m.incident_step_3_title(),
		body: m.incident_step_3_body(),
		shot: "flow-03-logs",
		caption: "Span detail with the Logs tab active — the records correlated to this trace id.",
	},
	{
		title: m.incident_step_4_title(),
		body: m.incident_step_4_body(),
		shot: "Maple's MCP server setup — endpoint plus one-line install for Claude Code, Cursor and Windsurf",
		src: "/screenshots/surface-mcp.webp",
	},
];
---

<section id="how-it-works" class="border-t border-border bg-bg" data-scrollstory data-active="1">
	<div class="shell pt-16 md:pt-32">
		<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{m.incident_eyebrow()}</p>
		<h2
			class="mt-4 max-w-[20ch] font-display text-3xl font-medium leading-[1.05] tracking-[-0.02em] text-fg md:text-[40px] lg:text-[54px]"
		>
			{m.incident_title()}
		</h2>
		<p class="mt-5 max-w-[62ch] text-sm leading-relaxed text-fg-muted md:text-[15px]">{m.incident_lede()}</p>
	</div>

	<div class="shell grid gap-12 pb-16 md:pb-32 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
		<!-- Pinned pane. `self-start` is load-bearing; without it the grid item
		     stretches and sticky stops working. -->
		<div data-sticky class="sticky top-24 order-2 hidden h-[80svh] self-start lg:block">
			<div class="relative flex h-full items-center">
				{
					steps.map((step, i) => (
						<div data-pane={i + 1} class="absolute inset-0 flex items-center">
							<MediaFrame label={step.shot} caption={step.caption} src={step.src} class="w-full" />
						</div>
					))
				}
			</div>
		</div>

		<ol class="order-1">
			{
				steps.map((step, i) => (
					<li
						data-step={i + 1}
						class="flex min-h-[60svh] flex-col justify-center border-t border-border py-10 lg:min-h-svh lg:py-0"
					>
						<span class="text-[11px] font-medium tabular-nums text-primary">
							{String(i + 1).padStart(2, "0")}
						</span>
						<h3 class="mt-3 font-display text-xl leading-snug tracking-[-0.01em] text-fg md:text-2xl">
							{step.title}
						</h3>
						<p class="mt-4 max-w-[52ch] text-sm leading-relaxed text-fg-muted">{step.body}</p>
						<div data-inline class="mt-7 lg:hidden">
							<MediaFrame label={step.shot} caption={step.caption} src={step.src} />
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	// One observer, no scroll handler, no rAF loop. The collapsed rootMargin
	// leaves a 10% band at the vertical centre, so exactly one step is
	// intersecting at a time and `data-active` never thrashes.
	const root = document.querySelector<HTMLElement>("[data-scrollstory]");

	if (root && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						const step = (entry.target as HTMLElement).dataset.step;
						if (step) root.dataset.active = step;
					}
				}
			},
			{ rootMargin: "-45% 0px -45% 0px", threshold: 0 },
		);
		root.querySelectorAll<HTMLElement>("[data-step]").forEach((step) => observer.observe(step));
	}
</script>
