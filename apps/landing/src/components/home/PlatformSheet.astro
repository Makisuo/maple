---

<section id="features" class="border-t border-border bg-bg">
	<div class="shell py-16 md:py-32">
		<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{m.platform_eyebrow()}</p>
		<h2
			class="mt-4 max-w-[20ch] font-display text-3xl font-medium leading-[1.05] tracking-[-0.02em] text-fg md:text-[40px] lg:text-[54px]"
		>
			{m.platform_title()}
		</h2>
		<p class="mt-5 max-w-[62ch] text-sm leading-relaxed text-fg-muted md:text-[15px]">{m.platform_lede()}</p>

		<div
			class="mt-12 grid gap-px overflow-hidden rounded-xl border border-border bg-border md:mt-16 md:grid-cols-2 lg:grid-cols-3"
		>
			{
				cells.map((cell, i) => (
					<div class="flex flex-col gap-4 bg-bg p-6 md:p-8">
						<span class="text-[11px] font-medium tabular-nums text-fg-muted">
							{String(i + 1).padStart(2, "0")}
						</span>
						<div>
							<h3 class="font-display text-lg leading-snug tracking-[-0.01em] text-fg md:text-xl">
								{cell.name}
							</h3>
							<p class="mt-2.5 max-w-[46ch] text-[13px] leading-relaxed text-fg-muted">{cell.desc}</p>
						</div>
						{cell.marks ? (
							/* Reuses `live-frame` and the same 1280×660 aspect as the
							   screenshots in cells 04 and 05, so the collage is exactly
							   as tall as its row neighbours instead of a short stub.

							   A fixed four-column matrix rather than wrapping flow:
							   seven marks in a flex-wrap fit one row at 1440 but
							   orphan the seventh onto a line of its own by `lg`, and
							   a stray single mark reads as a mistake. 4 + 3 is the
							   same deliberate shape at every width. */
							<div
								class="live-frame grid max-w-[380px] grid-cols-4 place-content-center justify-items-center gap-y-7 px-5"
								style={`aspect-ratio: ${MARK_ASPECT};`}
							>
								{cell.marks.map((mark) => (
									<span
										class="transition-transform duration-200 hover:scale-110 motion-reduce:transition-none motion-reduce:hover:scale-100"
										style={`color: ${mark.color};`}
										title={mark.name}
									>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox={mark.viewBox}
											width={markWidth(mark.viewBox)}
											height={MARK_H}
											fill="currentColor"
											fill-rule={mark.evenOdd ? "evenodd" : undefined}
											clip-rule={mark.evenOdd ? "evenodd" : undefined}
											role="img"
											aria-label={mark.name}
										>
											{mark.paths.map((d) => (
												<path d={d} />
											))}
										</svg>
									</span>
								))}
							</div>
						) : (
							/* Capped, not stretched: a cell is a third of the shell at
							   `lg` but full width on mobile, where an uncapped frame
							   would swamp its own copy. */
							<MediaFrame
								label={cell.shot}
								src={cell.src}
								width={cell.width}
								height={cell.height}
								class="max-w-[380px]"
							/>
						)}
						{cell.href && (
							<a
								href={cell.href}
								class="group mt-auto inline-flex items-center gap-1.5 pt-2 text-xs text-fg-muted transition-colors hover:text-fg"
							>
								{cell.link}
								<span class="transition-transform group-hover:translate-x-0.5">→</span>
							</a>
						)}
					</div>
				))
			}
