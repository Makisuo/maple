type CellBase = {
	name: string;
	desc: string;
	href: string | null;
	link: string | null;
};

/**
 * A cell carries either a screenshot or the logomark collage, never both —
 * hence a union rather than a bag of optionals. It narrows on `marks` in the
 * template, so the MediaFrame branch keeps `shot`/`src` as required strings.
 */
type Cell =
	| (CellBase & { shot: string; src: string; width: number; height: number; marks?: never })
	| (CellBase & { marks: Mark[]; shot?: never; src?: never; width?: never; height?: never });

const cells: Cell[] = [
	{
