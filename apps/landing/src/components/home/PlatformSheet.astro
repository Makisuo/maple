---
/**
 * 03 · Platform — the contact sheet, and the page's link hub to the feature
 * pages (SEO load-bearing).
 *
 * Deliberately NOT a card grid. DESIGN.md bans repeated card+icon+title+blurb
 * tiles by name, so this is one ruled plate: cells share edges via `gap-px` on
 * a `bg-border` fill, carry no individual radius, no individual background
 * lift, and no icons. Same construction the feature-page grids use.
 */
import * as m from "../../paraglide/messages.js";
import { featurePath } from "../../lib/page-registry";
import MediaFrame from "./MediaFrame.astro";

const locale = Astro.currentLocale ?? "en";
/**
 * Cells stay hand-composed — their copy is homepage-specific — but the hrefs go
 * through the registry's helper so a slug rename can't silently 404 the page's
 * main link hub.
 */
const l = (slug: string) => featurePath(locale, slug);

/**
 * Brand marks for cell 06, in full brand colour — this cell has no screenshot,
 * so the marks are the only thing carrying it, and monochrome glyphs read as a
 * footer logo row rather than a surface. PlanetScale and GitHub ship
 * near-monochrome marks that vanish on this background, so they take the
 * foreground token instead of their black brand value.
 *
 * Not every mark is a square 24×24 simple-icon — WarpStream is 618×477 across
 * eight paths, Hazel is 266×219 — so each carries its own viewBox and path
 * list, and the rendered width is derived from that aspect rather than assumed.
 */
interface Mark {
	name: string;
	viewBox: string;
	paths: string[];
	color: string;
	/** Hazel's mark needs even-odd to keep its cutouts; it inherits from the <svg>. */
	evenOdd?: boolean;
}

const MARK_H = 30;
const markWidth = (viewBox: string) => {
	const [, , w, h] = viewBox.split(" ").map(Number);
	return Math.round((MARK_H * w) / h);
};

/**
 * The capture aspect of cells 04 and 05, which share this row. Matching it
 * makes the collage frame exactly as tall as the screenshots beside it — keep
 * these in step if those two cells are ever re-captured at another size.
 */
const MARK_ASPECT = "1280 / 660";

// Kubernetes, Cloudflare and Prometheus reuse the same simple-icons paths
// SdkBand renders (MIT); PlanetScale, WarpStream, GitHub and Hazel are ported
// from apps/web/src/components/icons/.
