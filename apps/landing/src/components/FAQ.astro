---
import * as m from "../paraglide/messages.js";

interface Props {
    items: Array<{ question: string; answer: string }>;
    /** Pages laid out on the `.shell` grid pass true so the column sits on the
     *  same left axis as their other sections instead of centred. */
    shell?: boolean;
}

const { items, shell = false } = Astro.props;

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": items.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer,
        },
    })),
};
---

<section class="border-t border-border py-16 md:py-32">
    <div class={shell ? "shell" : "mx-auto max-w-3xl px-6"}>
        <span class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{m.faq_badge()}</span>
        <h2 class="mt-4 mb-12 font-display text-3xl font-medium tracking-[-0.02em] text-fg md:text-4xl">{m.faq_heading()}</h2>

        <div class:list={["divide-y divide-border border-t border-border", shell && "max-w-3xl"]}>
            {items.map(item => (
                <details class="faq-item">
                    <summary class="flex items-center justify-between py-5 cursor-pointer text-sm font-medium text-fg select-none">
                        <span>{item.question}</span>
                        <span class="ml-4 shrink-0 text-fg-muted">
                            <svg class="faq-plus w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                            <svg class="faq-minus w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14" />
                            </svg>
                        </span>
                    </summary>
                    <div class="pb-5 text-sm text-fg-muted leading-relaxed">
                        {item.answer}
                    </div>
                </details>
            ))}
        </div>
    </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<style is:global>
    .faq-item[open] .faq-plus {
        display: none;
    }
    .faq-item[open] .faq-minus {
        display: block;
    }
</style>
