---
import { NavBar } from "./NavBar"
import { getGitHubStars } from "../lib/github-stars"

const locale = Astro.currentLocale ?? "en";
const stars = await getGitHubStars();
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg transition-colors duration-200">
    <div class="shell h-16 flex items-center">
        <NavBar locale={locale} stars={stars} client:load />
    </div>
</nav>

<script>
    // Past the fold the bar drops one tonal step, rather than brightening its
    // border. Depth in this system is conveyed by tone, never by chroma — and
    // the hairline stays a hairline (no blur, no glass: DESIGN.md bans both).
    const nav = document.getElementById("main-nav");
    if (nav) {
        const update = () => {
            nav.classList.toggle("bg-bg-deep", window.scrollY > 100);
            nav.classList.toggle("bg-bg", window.scrollY <= 100);
        };
        window.addEventListener("scroll", update, { passive: true });
        update();
    }
</script>
