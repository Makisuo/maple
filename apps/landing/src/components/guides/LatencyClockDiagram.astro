<div
    class="latency-clock"
    role="img"
    aria-label="A checkout request moving from checkout-client through edge-proxy and order-service to orders-db and payment-api, with bars comparing total response time, time to first byte, and server request duration"
>
    <div class="latency-clock__header" aria-hidden="true">
        <span>trace / POST /checkout</span>
        <span class="latency-clock__status">p99 · 380 ms</span>
    </div>

    <div class="latency-clock__path" aria-hidden="true">
        <div class="latency-clock__node">
            <span class="latency-clock__kind">CLIENT</span>
            <strong>checkout-client</strong>
            <small>DNS · TCP · TLS</small>
        </div>
        <div class="latency-clock__connector"><span>request</span></div>
        <div class="latency-clock__node">
            <span class="latency-clock__kind">PROXY</span>
            <strong>edge-proxy</strong>
            <small>terminate · route</small>
        </div>
        <div class="latency-clock__connector"><span>forward</span></div>
        <div class="latency-clock__node latency-clock__node--active">
            <span class="latency-clock__kind">SERVER SPAN</span>
            <strong>order-service</strong>
            <small>application work</small>
        </div>
    </div>

    <div class="latency-clock__dependencies" aria-hidden="true">
        <span class="latency-clock__branch"></span>
        <div class="latency-clock__dependency">
            <span class="latency-clock__kind">DB SPAN</span>
            <strong>orders-db</strong>
            <small>SELECT orders</small>
        </div>
        <div class="latency-clock__dependency">
            <span class="latency-clock__kind">CLIENT SPAN</span>
            <strong>payment-api</strong>
            <small>POST /authorize</small>
        </div>
    </div>

    <div class="latency-clock__ruler" aria-hidden="true">
        <div class="latency-clock__ticks">
            <span>0 ms</span>
            <span>100</span>
            <span>200</span>
            <span>300</span>
            <span>400</span>
        </div>
        <div class="latency-clock__row">
            <div><strong>Total response</strong><small>client → final byte</small></div>
            <span class="latency-clock__bar latency-clock__bar--total"></span>
        </div>
        <div class="latency-clock__row">
            <div><strong>Time to first byte</strong><small>client → first byte</small></div>
            <span class="latency-clock__bar latency-clock__bar--ttfb"></span>
        </div>
        <div class="latency-clock__row">
            <div><strong>Server duration</strong><small>SERVER span only</small></div>
            <span class="latency-clock__bar latency-clock__bar--server"></span>
        </div>
    </div>
</div>

