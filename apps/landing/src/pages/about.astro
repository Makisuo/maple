---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import CompanyContent from "../components/CompanyContent.astro";
import { aboutPage } from "../lib/company";

const pageTitle = "About Maple — open-source observability built on OpenTelemetry";
const pageDescription = aboutPage.description;
---

<Layout title={pageTitle} description={pageDescription} alternates={["en"]} mdHref="/about.md">
    <SeoHead title={pageTitle} description={pageDescription} includeOrganization={true} />
    <Nav />
    <CompanyContent page={aboutPage} />
    <Footer />
</Layout>
