---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const locale = Astro.currentLocale ?? "en";
const l = (path: string) => getRelativeLocaleUrl(locale, path);
---

<Layout title="Page Not Found — Maple" description="The page you're looking for doesn't exist or has been moved.">
    <Nav />
    <section class="relative pt-[19px] min-h-[70vh] flex items-center justify-center">
        <div class="mx-auto max-w-6xl px-6 text-center">
            <p class="text-7xl font-bold text-fg-muted/20 mb-6">404</p>
            <h1 class="text-2xl sm:text-3xl font-bold text-fg mb-3">Page not found</h1>
            <p class="text-sm text-fg-muted max-w-md mx-auto mb-8">
                The page you're looking for doesn't exist or has been moved.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href={l("/")} class="bg-primary text-primary-foreground px-6 py-2.5 text-sm font-medium hover:opacity-90 transition-opacity">
                    Back to home
                </a>
                <a href={l("/features/distributed-tracing")} class="border border-border px-6 py-2.5 text-sm font-medium text-fg hover:opacity-90 transition-opacity">
                    View features
                </a>
            </div>
            <!-- Same recovery links the markdown 404 (src/worker.ts) gives agents. -->
            <p class="mt-10 text-xs text-fg-muted">
                Looking for something specific?
                <a href="/docs" class="text-fg underline underline-offset-4 hover:text-primary transition-colors">Docs</a>
                ·
                <a href={l("/pricing")} class="text-fg underline underline-offset-4 hover:text-primary transition-colors">Pricing</a>
                ·
                <a href="/changelog" class="text-fg underline underline-offset-4 hover:text-primary transition-colors">Changelog</a>
                ·
                <a href="/contact" class="text-fg underline underline-offset-4 hover:text-primary transition-colors">Contact</a>
                ·
                <a href="/sitemap-index.xml" class="text-fg underline underline-offset-4 hover:text-primary transition-colors">Sitemap</a>
                ·
                <a href="/llms.txt" class="text-fg underline underline-offset-4 hover:text-primary transition-colors">llms.txt</a>
            </p>
        </div>
    </section>
    <Footer />
</Layout>
