---
// /docs — the front door. Three questions, in order: where do I start, how do
// I get my language in, and what else is documented. Everything is read from
// the collection so a new page shows up here without touching this file.
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import DocsCategoryIcon from "../../components/docs/DocsCategoryIcon.astro";
import LanguageLogo from "../../components/docs/LanguageLogo.astro";
import BrandMarkIcon from "../../components/BrandMarkIcon.astro";
import { LANGUAGES } from "../../lib/docs-languages";
import { INSTRUMENTATION_SLUG, groupBlurb, groupRank } from "../../lib/docs-nav";

const allDocs = await getCollection("docs", ({ data }) => !data.draft);
type Doc = (typeof allDocs)[number];
const byOrder = (a: Doc, b: Doc) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title);
const bySlug = (slug: string) => allDocs.find((d) => d.id === slug);

const START_HERE = [
    "getting-started/introduction",
    INSTRUMENTATION_SLUG,
    "local-mode",
    "mcp",
].flatMap((slug) => {
    const doc = bySlug(slug);
    return doc ? [doc] : [];
});

// Every group except the two the page already covers above.
const HIDDEN_GROUPS = new Set<string>(["Getting Started", "Instrumentation"]);
const topics = [...new Set(allDocs.map((d) => d.data.group))]
    .filter((g) => !HIDDEN_GROUPS.has(g))
    .sort((a, b) => groupRank(a) - groupRank(b) || a.localeCompare(b))
    .map((group) => ({
        group,
        blurb: groupBlurb(group),
        docs: allDocs.filter((d) => d.data.group === group).sort(byOrder),
    }));
---

<DocsLayout
    title="Documentation"
    description="Technical documentation for the Maple observability platform: instrumentation guides, concepts, integrations, alerting, local mode and the API."
    headings={[]}
    currentSlug=""
    mdHref="/docs.md"
    wide
>
    <div class="docs-index">
        <header>
            <h1 class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em] text-fg">Documentation</h1>
            <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-fg-muted">
                Maple is an OpenTelemetry-native observability platform for traces, logs, metrics, errors and sessions. Point any OTel SDK at it and start exploring; these pages cover the how.
            </p>
        </header>

        {/* ── Start here ─────────────────────────────────────── */}
        <section class="mt-10" aria-labelledby="start-here">
            <h2 id="start-here" class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">Start here</h2>
            <div class="hairline-grid mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
                {START_HERE.map((doc) => (
                    <a href={`/docs/${doc.id}`} class="cell block p-5 transition-colors hover:bg-bg-elevated">
                        <span class="block text-[13px] font-medium text-fg">{doc.data.title}</span>
                        <p class="mt-1.5 text-[12px] leading-relaxed text-fg-muted line-clamp-3">{doc.data.description}</p>
                    </a>
                ))}
            </div>
        </section>

        {/* ── Instrumentation ─────────────────────────────────── */}
        <section class="mt-12" aria-labelledby="instrument">
            <div class="flex items-baseline justify-between gap-4">
                <h2 id="instrument" class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">Instrument your application</h2>
                <a href={`/docs/${INSTRUMENTATION_SLUG}`} class="text-[12.5px] text-primary transition-colors hover:text-fg">All guides</a>
            </div>
            <div class="hairline-grid mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
                {LANGUAGES.map((lang) => (
                    <a href={`/docs/${lang.slug}`} class="cell flex items-center gap-3 p-4 transition-colors hover:bg-bg-elevated">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-bg-elevated" aria-hidden="true">
                            <LanguageLogo id={lang.id} class="h-4 w-4" />
                        </span>
                        <span class="truncate text-[13px] font-medium text-fg">{lang.name}</span>
                    </a>
                ))}
                <a href="/docs/session-replay/browser-sdk" class="cell flex items-center gap-3 p-4 transition-colors hover:bg-bg-elevated">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-bg-elevated" aria-hidden="true">
                        <BrandMarkIcon id="javascript" class="h-4 w-4" />
                    </span>
                    <span class="truncate text-[13px] font-medium text-fg">Browser</span>
                </a>
                <a href={`/docs/${INSTRUMENTATION_SLUG}#anything-that-speaks-otlp`} class="cell flex items-center gap-3 p-4 transition-colors hover:bg-bg-elevated">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-bg-elevated" aria-hidden="true">
                        <BrandMarkIcon id="opentelemetry" class="h-4 w-4" />
                    </span>
                    <span class="truncate text-[13px] font-medium text-fg">Any OTLP exporter</span>
                </a>
            </div>
        </section>

        {/* ── Browse by topic ─────────────────────────────────── */}
        <section class="mt-12" aria-labelledby="topics">
            <h2 id="topics" class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">Browse by topic</h2>
            <div class="hairline-grid mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                {topics.map(({ group, blurb, docs }) => (
                    <div class="cell p-5">
                        <h3 class="flex items-center gap-2 text-[13px] font-medium text-fg">
                            <DocsCategoryIcon name={group} class="h-3.5 w-3.5 shrink-0 text-primary/80" />
                            {group}
                        </h3>
                        {blurb && <p class="mt-1.5 text-[12px] leading-relaxed text-fg-muted">{blurb}</p>}
                        <ul class="mt-3 space-y-1.5">
                            {docs.map((doc) => (
                                <li>
                                    <a href={`/docs/${doc.id}`} class="text-[12.5px] text-fg-muted transition-colors hover:text-fg">
                                        {doc.data.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>

        {/* ── Footer ──────────────────────────────────────────── */}
        <footer class="mt-12 flex flex-col gap-2 border-t border-border pt-6 text-[12px] text-fg-muted sm:flex-row sm:items-center sm:justify-between">
            <p>
                Every page is also plain markdown: append <code class="rounded bg-bg-elevated px-1.5 py-0.5 text-fg">.md</code> to its URL, or start from
                <a href="/llms.txt" class="text-fg transition-colors hover:text-primary">/llms.txt</a>.
            </p>
            <p class="flex items-center gap-3">
                <a href="https://github.com/MapleTechLabs/maple" class="text-fg transition-colors hover:text-primary">GitHub</a>
                <a href="https://github.com/MapleTechLabs/maple/issues" class="text-fg transition-colors hover:text-primary">Report a docs issue</a>
            </p>
        </footer>
    </div>
</DocsLayout>

<style>
    /* Hairline grid that tolerates a short last row: each cell draws its own
       1px frame, so an empty slot reads as an empty cell rather than a block
       of border colour. */
    .hairline-grid {
        gap: 1px;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: var(--background);
    }
    .hairline-grid > .cell {
        background: var(--background);
        box-shadow: 0 0 0 1px var(--border);
    }
    .hairline-grid > a.cell:hover {
        background: var(--bg-elevated);
    }
</style>
