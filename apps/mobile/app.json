{
	"expo": {
		"name": "maple",
		"slug": "maple",
		"scheme": "maple",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#171410"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.maple.mobile",
			"associatedDomains": ["applinks:clerk.maple.dev"],
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#171410"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.maple.mobile"
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": ["expo-router", "@clerk/expo", "expo-secure-store", "expo-web-browser"],
		"extra": {
			"router": {},
			"eas": {
				"projectId": "7df081bd-dbf0-41dc-981b-eaf4428d7996"
			}
		},
		"owner": "makisuo"
	}
}
