{
	// Source wrangler config. The `@flue/vite` plugin reads this and emits the
	// deployable config to `.flue-vite.wrangler.jsonc` (with Flue's generated
	// entrypoint + Durable Object bindings). Deploy the GENERATED one, never this
	// source file. Never hand-author `FLUE_*` DO bindings here — the plugin owns
	// them and rejects a conflicting authored binding. Migrations stay ours.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "maple-chat-flue",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers AI binding — drives the `cloudflare/*` model provider (env.AI.run).
	"ai": {
		"binding": "AI",
	},
	// Flue-generated Durable Object classes, one per agent:
	// `Flue<PascalCase(identity)>Agent`, bound as `FLUE_<SNAKE_UPPER(identity)>_AGENT`.
	// Append-only once deployed: never rewrite a deployed migration tag.
	//
	// v2 (Flue 2) drops the central registry and the workflow runtime. The chat
	// agent's identity is still `maple-chat`, which folds to the SAME class name
	// `FlueMapleChatAgent` v1 deployed — so it is deliberately absent below:
	// renaming or re-declaring it would discard every existing conversation.
	// Triage stopped being a workflow and became an agent, so its old DO class is
	// deleted and a new one provisioned (headless, no history worth keeping).
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["FlueRegistry", "FlueMapleChatAgent", "FlueTriageWorkflow"],
		},
		{
			"tag": "v2",
			"deleted_classes": ["FlueRegistry", "FlueTriageWorkflow"],
			"new_sqlite_classes": ["FlueTriageAgent"],
		},
	],
	"services": [{ "binding": "MAPLE_API_RPC", "service": "maple-api" }],
	// Workers Observability — `traces.enabled` is required for `tracing.enterSpan`
	// custom spans; the "maple" destination forwards logs + traces to Maple ingest.
	// The real deploy is Alchemy-owned (alchemy.run.ts sets this too); kept here in
	// sync for the Flue-native manual deploy + `wrangler dev`.
	"observability": {
		"enabled": true,
		"logs": {
			"destinations": ["maple"],
		},
		"traces": {
			"enabled": true,
			"destinations": ["maple"],
		},
	},
}
