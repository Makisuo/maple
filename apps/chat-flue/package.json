{
	"name": "@maple/chat-flue",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "portless",
		"build": "flue build --target cloudflare",
		"deploy": "flue build --target cloudflare && wrangler deploy --config dist/maple_chat_flue/wrangler.json",
		"connect": "flue connect maple-chat local",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"dev:app": "bun run ../../scripts/sync-chat-flue-dev-vars.ts && flue dev --target cloudflare --port ${PORT:-3583}"
	},
	"portless": {
		"name": "chat-flue",
		"script": "dev:app"
	},
	"dependencies": {
		"@clerk/backend": "^2.30.1",
		"@flue/opentelemetry": "1.0.0-beta.3",
		"@flue/runtime": "1.0.0-beta.9",
		"@maple/domain": "workspace:*",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.205.0",
		"@opentelemetry/core": "^2.0.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.205.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
		"@opentelemetry/resources": "^2.0.0",
		"@opentelemetry/sdk-logs": "^0.205.0",
		"@opentelemetry/sdk-trace-base": "^2.0.0",
		"@opentelemetry/semantic-conventions": "^1.36.0",
		"agents": "^0.14.1",
		"alchemy": "2.0.0-beta.64",
		"hono": "^4.8.3",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "4.20260603.1",
		"@flue/cli": "1.0.0-beta.9",
		"@valibot/to-json-schema": "^1.3.0",
		"typescript": "catalog:tooling",
		"vitest": "catalog:",
		"wrangler": "^4.41.0"
	}
}
