{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "apps/scraper/Dockerfile",
		"watchPatterns": [
			"apps/scraper/**",
			"packages/domain/**",
			"packages/effect-sdk/**",
			"lib/clickhouse-builder/**"
		]
	},
	"deploy": {
		"healthcheckPath": "/health",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	}
}
