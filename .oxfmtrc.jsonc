{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": false,
	"printWidth": 110,
	"useTabs": true,
	"tabWidth": 4,
	// packages/db/drizzle is drizzle-kit output — the next `db:generate` rewrites
	// it in drizzle's own style, so formatting it is churn that only obscures the
	// migration-snapshot diff.
	// lib/llm and lib/thinking-orbs are vendored upstream source in prettier style;
	// reformatting them would turn every future upstream sync into a whole-file conflict.
	// packages/email/emails are Maizzle sources whose whitespace is load-bearing — a
	// newline inserted between two inline elements becomes a rendered space in the
	// email, and the files are authored in the exact shape they compile to.
	"ignorePatterns": [
		".context",
		"deploy",
		"skills",
		"packages/db/drizzle",
		"lib/llm",
		"lib/thinking-orbs",
		"packages/email/emails",
	],
}
